DATABASE_URL=sqlite:///./supermarket.db
SECRET_KEY=change-this-to-a-long-random-secret

# Runtime toggles
ENABLE_NGROK=true
ENABLE_TELEGRAM_POLLING=true
AUTO_APPLY_SQLITE_COMPATIBILITY=true

# Timezone / session behavior
APP_TIMEZONE=Asia/Jerusalem
TRUST_PROXY_HEADERS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Optional integrations
NGROK_AUTHTOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Alerts / operations
ALERT_LARGE_INVOICE_AMOUNT=500
